# ── Python cache / bytecode ──────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyc
*.pyd
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
.env

# ── Output / data artifacts (too large for git) ───────────────
outputs/
db/
chroma_data/
*.db
*.sqlite
*.sqlite3

# ── Disk images (can be multiple GB) ─────────────────────────
*.img
*.iso

# ── Jupyter checkpoints ───────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── ML model checkpoints ──────────────────────────────────────
*.pt
*.pth
*.ckpt
*.pkl
*.joblib

# ── OS artifacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE config ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Secrets / credentials ─────────────────────────────────────
.env
*.env
secrets.json
credentials.json
